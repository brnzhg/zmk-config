#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define OHND    1
#define NUMP    2
#define MODL    3
#define MODR    4
#define NAVL    5
#define NAVR    6

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  ENTER |  | ENTER |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | ALT  | GUI  | MODL |  ESC   |  | SPACE | MODR | NUMP  | GUI   |
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                           &kp N6   &kp N7   &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                            &kp Y    &kp U    &kp I     &kp O   &kp P    &kp BSLH
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                            &kp H    &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B    &kp ENTER     &kp ENTER &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &kp LGUI &mo MODL &lt OHND ESC  &kp SPACE &mo MODR &mo NUMP &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        ohnd_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------
// |  F12  |  F1  |  F2        |  F3     |  F4         |  F5   |                   |  F6     |  F7     |  F8       |  F9        |  F10  |  F11  |
// |       |      |  BSPC      |  msc    |  SCRL_DOWN  |       |                   |         |  msc    |  SCRL_UP  |  BSPC      |       |       |
// |       |      |  RC(BSPC)  |  MB2    |  MB1        |  MB3  |                   |  ENTER  |  MB1    |  MB2      |  RC(BSPC)  |       |       |
// |       |      |            |  PG_UP  |  PG_DN      |       |  ENTER |  | ENTER |         |  PG_DN  |  PG_UP    |            |       |       |
//                             |         |             |       |        |  |       |         |         |           |
            bindings = <
&kp F12  &kp F1  &kp F2        &kp F3        &kp F4          &kp F5                       &kp F6     &kp F7     &kp F8     &kp F9        &kp F10  &kp F11
&trans   &trans  &kp BSPC      &msc SCRL_UP  &msc SCRL_DOWN  &trans                       &trans     &kp PG_DN  &kp PG_UP  &kp BSPC      &trans   &trans
&trans   &trans  &kp RC(BSPC)  &mkp MB2      &mkp MB1        &mkp MB3                     &kp ENTER  &mkp MB1   &mkp MB2   &kp RC(BSPC)  &trans   &trans
&trans   &trans  &trans        &kp PG_UP     &kp PG_N        &trans    &trans   &trans    &trans     &kp PG_DN  &kp PG_UP  &trans        &trans   &trans
                               &trans        &trans          &trans    &trans   &trans    &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nump_layer {
// TODO put mods on the other side
// ---------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |         |   /   |   *   |  (   |   )   |       |
// |       |     |     |      |      |      |                   |         |   7   |   8   |  9   |   [   |   ]   |
// |       |     |     |      |      |      |                   |  ENTER  |   4   |   5   |  6   |   -   |   =   |
// |       |     |     |      |      |      |        |  |       |  0      |   1   |   2   |  3   |   .   |       |
//                     |      |      |      |        |  |       |         |       |       |
            bindings = <
&trans &trans &trans &trans &trans &trans                      &trans     &kp FSLH  &kp STAR  &kp LPAR  &kp RPAR   &trans
&trans &trans &trans &trans &trans &trans                      &trans     &kp N7    &kp N8    &kp N9    &kp LBKT   &kp RBKT
&trans &trans &trans &trans &trans &trans                      &kp ENTER  &kp N4    &kp N5    &kp N6    &kp MINUS  &kp EQUAL
&trans &trans &trans &trans &trans &trans   &trans   &trans    &kp N0     &kp N1    &kp N2    &kp N3    &kp DOT    &trans
                            &trans &trans   &trans   &trans    &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        modl_layer {
// -----------------------------------------------------------------------------------------------------------------------
// |       |       |       |         |        |        |                   |      |       |       |      |       |       |
// |       |       |       |         |        |        |                   |      |       |       |      |       |       |
// |       |  GUI  |  ALT  |  SHIFT  |  CTRL  |  NAVL  |                   |      |       |       |      |       |       |
// |       |       |       |         |        |  NUMP  |        |  |       |      |       |       |      |       |       |
//                         |         |        |        |        |  |       |      |       |       |
            bindings = <
&trans  &trans    &trans    &trans      &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans      &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  &mo NAVL                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans      &trans     &mo NUMP  &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans      &trans     &trans    &trans   &trans    &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        modr_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// |       |       |       |        |        |        |                   |        |        |         |       |       |       |
// |       |       |       |        |        |        |                   |        |        |         |       |       |       |
// |       |       |       |        |        |        |                   |  NAVR  |  CTRL  |  SHIFT  |  ALT  |  GUI  |       |
// |       |       |       |        |        |        |        |  |       |        |        |         |       |       |       |
//                         |        |        |        |        |  |       |        |        |         |
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans    &trans    &trans      &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans    &trans    &trans      &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &mo NAVR  &kp RCTRL &kp RSHIFT  &kp RALT  &kp RGUI  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans    &trans    &trans    &trans      &trans    &trans    &trans
                        &trans  &trans  &trans    &trans   &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navl_layer {
// ---------------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |        |         |         |         |       |       |
// |       |     |     |      |      |      |                   |  HOME  |  DEL    |  INS    |  END    |       |       |
// |       |     |     |      |      |      |                   |  LEFT  |  DOWN   |  UP     |  RIGHT  |       |       |
// |       |     |     |      |      |      |        |  |       |        |  PG_DN  |  PG_UP  |         |       |       |
//                     |      |      |      |        |  |       |        |         |         |
            bindings = <
&trans &trans &trans &trans &trans &trans                      &trans    &trans     &trans     &trans     &trans  &trans
&trans &trans &trans &trans &trans &trans                      &kp HOME  &kp DEL    &kp INS    &kp END    &trans  &trans
&trans &trans &trans &trans &trans &trans                      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans &trans &trans &trans &trans &trans   &trans   &trans    &trans    &kp PG_DN  &kp PG_UP  &trans     &trans  &trans
                            &trans &trans   &trans   &trans    &trans    &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navr_layer {
// ---------------------------------------------------------------------------------------------------------------------
// |       |     |         |         |         |        |                   |       |       |       |      |     |     |
// |       |     |  END    |  INS    |  DEL    |  HOME  |                   |       |       |       |      |     |     |
// |       |     |  RIGHT  |  UP     |  DOWN   |  LEFT  |                   |       |       |       |      |     |     |
// |       |     |         |  PG_UP  |  PG_DN  |        |        |  |       |       |       |       |      |     |     |
//                         |         |         |        |        |  |       |       |       |       |
            bindings = <
&trans &trans &trans     &trans     &trans     &trans                     &trans &trans &trans &trans &trans &trans
&trans &trans &kp END    &kp INS    &kp DEL    &kp HOME                   &trans &trans &trans &trans &trans &trans
&trans &trans &kp RIGHT  &kp UP     &kp DOWN   &kp LEFT                   &trans &trans &trans &trans &trans &trans
&trans &trans &trans     &kp PG_UP  &kp PG_DN  &trans    &trans   &trans  &trans &trans &trans &trans &trans &trans
                         &trans     &trans     &trans    &trans   &trans  &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
