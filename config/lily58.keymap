#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

#define DEFAULT 0
#define OHND    1
#define NUMP    2
#define SYMB    3
#define MODL    4
#define MODR    5
#define NAVL    6
#define NAVR    7
#define BLTH    8
#define GAME    9

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  -     |  | =     |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | GUI  | ALT  |ESC/OHND| MODL |  | MODR  | SPACE | OHND  | GUI   |
            bindings = <
&kp GRAVE &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                               &kp N6    &kp N7    &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                                &kp Y     &kp U     &kp I     &kp O   &kp P    &kp BSLH
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                                &kp H     &kp J     &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B         &kp MINUS   &kp EQUAL  &kp N     &kp M     &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LGUI &kp LALT &lt OHND ESC  &mo MODL    &mo MODR   &kp SPACE &mo OHND &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        ohnd_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------
// |  F12  |  F1  |  F2        |  F3     |  F4         |  F5   |                   |  F6     |  F7     |  F8       |  F9        |  F10  |  F11  |
// |       |      |  RC BSPC   | SCRL_UP |  SCRL_DOWN  |       |                   |         |SCRL_DOWN|  SCRL_UP  |  RC BSPC   |       |       |
// |       |      |  BSPC      |  MB2    |  MB1        |  MB3  |                   |         |  MB1    |  MB2      |  BSPC      |       | ENTER |
// |       |      |            |  PG_UP  |  PG_DN      |       |        |  |       |         |  PG_DN  |  PG_UP    |            |       |       |
//                             |         |             |       |        |  |       |         |         |           |
            bindings = <
&kp F12  &kp F1  &kp F2         &kp F3        &kp F4          &kp F5                       &kp F6     &kp F7          &kp F8        &kp F9        &kp F10  &kp F11
&trans   &trans  &kp RC(BSPC)   &msc SCRL_UP  &msc SCRL_DOWN  &trans                       &trans     &msc SCRL_DOWN  &msc SCRL_UP  &kp RC(BSPC)  &trans   &trans
&trans   &trans  &kp BSPC       &mkp MB2      &mkp MB1        &mkp MB3                     &trans     &mkp MB1        &mkp MB2      &kp BSPC      &trans   &kp ENTER
&trans   &trans  &trans         &kp PG_UP     &kp PG_DN       &trans    &trans   &trans    &trans     &kp PG_DN       &kp PG_UP     &trans        &trans   &trans
                                &trans        &trans          &trans    &trans   &trans    &trans     &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nump_layer {
// TODO put mods on the other side
// ------------------------------------------------------------------------------------------------------------------
// |       |     |      |      |      |      |                   |         |   [   |   ]   |  (   |   )   |         |
// |       |     |      |      |      |      |                   |  =      |   7   |   8   |  9   |   /   |         |
// |       |     | mods |      |      |      |                   |  -      |   4   |   5   |  6   |   *   |  ENTER  |
// |       |     |      |      |      |      |        |  |       |  +      |   1   |   2   |  3   |   .   |         |
//                      |      |      |      |        |  |       |         |   0   |       |
            bindings = <
&trans &trans    &trans    &trans      &trans     &trans                      &trans     &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR  &trans
&trans &trans    &trans    &trans      &trans     &trans                      &kp EQUAL  &kp N7    &kp N8    &kp N9    &kp FSLH  &trans
&trans &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  &trans                      &kp MINUS  &kp N4    &kp N5    &kp N6    &kp STAR  &kp ENTER
&trans &trans    &trans    &trans      &trans     &trans   &trans   &trans    &kp PLUS   &kp N1    &kp N2    &kp N3    &kp DOT   &trans
                           &trans      &trans     &trans   &trans   &trans    &trans     &kp N0    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symb_layer {
// TODO put mods on the other side
// ------------------------------------------------------------------------------------------------------------------
// |       |     |      |      |      |      |                   |         |   {   |   }   |  (   |   )   |         |
// |       |     |      |      |      |      |                   |  +      |   &   |   *   |  )   |       |         |
// |       |     | mods |      |      |      |                   |  _      |   $   |   %   |  ^   |       |  ENTER  |
// |       |     |      |      |      |      |        |  |       |         |   !   |   @   |  #   |       |         |
//                      |      |      |      |        |  |       |         |   (   |       |
            bindings = <
&trans &trans    &trans    &trans      &trans     &trans                      &trans     &kp LBRC  &kp RBRC   &kp LPAR  &kp RPAR  &trans
&trans &trans    &trans    &trans      &trans     &trans                      &kp PLUS   &kp AMPS  &kp STAR   &kp RPAR  &trans    &trans
&trans &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  &trans                      &kp UNDER  &kp DLLR  &kp PRCNT  &kp CARET &trans    &kp ENTER
&trans &trans    &trans    &trans      &trans     &trans   &trans   &trans    &trans     &kp EXCL  &kp AT     &kp HASH  &trans    &trans
                           &trans      &trans     &trans   &trans   &trans    &trans     &kp LPAR  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        modl_layer {
// -----------------------------------------------------------------------------------------------------------------------
// |       |       |       |         |        |        |                   |      |       |       |      |       |       |
// |       |       |       |         |        |  SYM   |                   |      |       |       |      |       |       |
// |       |  GUI  |  ALT  |  SHIFT  |  CTRL  |  NAVL  |                   |      |       |       |      |       |       |
// | CAPS  |       |       |         |        |  NUMP  |        |  |       |      |       |       |      |       | CAPS  |
//                         |         |        |        |        |  | BLTH  |      |       |       |
            bindings = <
&trans    &trans    &trans    &trans      &trans     &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans    &trans    &trans      &trans     &mo SYMB                     &trans  &trans  &trans  &trans  &trans  &trans
&trans    &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  &mo NAVL                     &trans  &trans  &trans  &trans  &trans  &trans
&kp CAPS  &trans    &trans    &trans      &trans     &mo NUMP  &trans   &trans    &trans  &trans  &trans  &trans  &trans  &kp CAPS
                              &trans      &trans     &trans    &trans   &mo BLTH  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        modr_layer {
// ----------------------------------------------------------------------------------------------------------------------------
// |       |       |       |        |        |        |                   |        |        |         |       |       |       |
// |       |       |       |        |        |        |                   |        |        |         |       |       |       |
// |       |       |       |        |        |        |                   |  NAVR  |  CTRL  |  SHIFT  |  ALT  |  GUI  |       |
// | CAPS  |       |       |        |        |        |        |  |       |        |        |         |       |       | CAPS  |
//                         |        |        |        |  BLTH  |  |       |        |        |         |
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans                         &trans    &trans    &trans      &trans    &trans    &trans
&trans    &trans  &trans  &trans  &trans  &trans                         &trans    &trans    &trans      &trans    &trans    &trans
&trans    &trans  &trans  &trans  &trans  &trans                         &mo NAVR  &kp RCTRL &kp RSHIFT  &kp RALT  &kp RGUI  &trans
&kp CAPS  &trans  &trans  &trans  &trans  &trans    &trans     &trans    &trans    &trans    &trans      &trans    &trans    &kp CAPS
                          &trans  &trans  &trans    &mo BLTH   &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navl_layer {
// -----------------------------------------------------------------------------------------------------------------------
// |  Fs     |     |     |      |      |      |                   |        |         |         |         |       |       |
// |         |     |     |      |      |      |                   |  HOME  |  DEL    |  INS    |  END    |       |       |
// |         |     |     |      |      |      |                   |  LEFT  |  DOWN   |  UP     |  RIGHT  |       | ENTER |
// |         |     |     |      |      |      |        |  |       |        |  PG_DN  |  PG_UP  |         |       |       |
//                       |      |      |      |        |  |       |        |         |         |
            bindings = <
&kp F12  &kp F1    &kp F2    &kp F3      &kp F4     &kp F5                      &kp F6    &kp F7     &kp F8     &kp F9     &kp F10  &kp F11
&trans   &trans    &trans    &trans      &trans     &trans                      &kp HOME  &kp DEL    &kp INS    &kp END    &trans   &trans
&trans   &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  &trans                      &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans   &kp ENTER
&trans   &trans    &trans    &trans      &trans     &trans   &trans   &trans    &trans    &kp PG_DN  &kp PG_UP  &trans     &trans   &trans
                             &trans      &trans     &trans   &trans   &trans    &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navr_layer {
// -----------------------------------------------------------------------------------------------------------------------
// |  Fs   |     |         |         |         |        |                   |       |       |       |      |     |       |
// |       |     |  END    |  INS    |  DEL    |  HOME  |                   |       |       |       |      |     |       |
// |       |     |  RIGHT  |  UP     |  DOWN   |  LEFT  |                   |       |       |       |      |     | ENTER |
// |       |     |         |  PG_UP  |  PG_DN  |        |        |  |       |       |       |       |      |     |       |
//                         |         |         |        |        |  |       |       |       |       |
            bindings = <
&kp F12 &kp F1  &kp F2     &kp F3     &kp F4     &kp F5                     &kp F6  &kp F7     &kp F8      &kp F9    &kp F10   &kp F11
&trans  &trans  &kp END    &kp INS    &kp DEL    &kp HOME                   &trans  &trans     &trans      &trans    &trans    &trans
&trans  &trans  &kp RIGHT  &kp UP     &kp DOWN   &kp LEFT                   &trans  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  &kp ENTER
&trans  &trans  &trans     &kp PG_UP  &kp PG_DN  &trans    &trans   &trans  &trans  &trans     &trans      &trans    &trans    &trans
                           &trans     &trans     &trans    &trans   &trans  &trans  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        blth_layer {
// --------------------------------------------------------------------------------------------------------------------------------
// | EXT PWR TOGGLE | BT1     | BT2    |  BT3 |  BT4  |  BT5 |                    | PLAY | VOL_DN | VOL_UP |      |       |       |
// |                | BT_CLR  | OUT_TG |      |       |      |                    |      |        |        |      |       |       |
// |                |         |        |      |       |  GME |                    |      |        |        |      |       |       |
// |                |         |        |      |       |      |       |  |         |      |        |        |      |       |       |
//                                     |      |       |      |       |  |         |      |        |        |
            bindings = <
    &ext_power EP_TOG &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &kp C_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans  &trans
    &trans            &bt BT_CLR    &out OUT_TOG   &trans        &trans        &trans                             &trans    &trans   &trans    &trans  &trans  &trans
    &trans            &trans        &trans         &trans        &trans        &tog GAME                          &trans    &trans   &trans    &trans  &trans  &trans
    &trans            &trans        &trans         &trans        &trans        &trans         &trans    &trans    &trans    &trans   &trans    &trans  &trans  &trans
                                                   &trans        &trans        &trans         &trans    &trans    &trans    &trans   &trans    
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


        game_layer {
// TODO put mods on the other side
// ------------------------------------------------------------------------------------------------------------------
// |       |     |      |      |      |      |                   |         |       |       |      |       |         |
// |       |     |      |  W   |      |      |                   |         |  KP7  |  KP8  | KP9  |       |         |
// |       |     |  A   |  S   |  D   | GME  |                   |         |  KP4  |  KP5  | KP6  |       |  ENTER  |
// |       |     |      |      |      |      |        |  |       |         |  KP1  |  KP2  | KP3  |       |         |
//                      |      |      |      |        |  |       |         |   0   |       |
            bindings = <
&trans &trans    &trans    &trans      &trans     &trans                       &trans  &trans     &trans     &trans     &trans  &trans
&trans &trans    &trans    &kp W       &trans     &trans                       &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans  &trans
&trans &trans    &kp A     &kp S       &kp D      &tog GAME                    &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans  &kp ENTER
&trans &trans    &trans    &trans      &trans     &trans    &trans   &trans    &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans  &trans
                           &trans      &trans     &trans    &trans   &trans    &trans  &kp KP_N0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


    };
};
